AIRTABLE_API_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_DRAWINGS_TABLE=Drawings
AIRTABLE_DRAWINGS_IMAGE_FIELD=Image
AIRTABLE_SCORES_TABLE=Scores
ADMIN_TOKEN=replace-with-a-long-random-server-token
# Enable only behind a trusted proxy that sanitizes X-Forwarded-For.
TRUST_PROXY=0

# Account system (phase 2). Apply migrations/001_tamagotchi.sql and the seed first.
# Canonical origin: no trailing path. Use your HTTPS site origin in production.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Server only. A new secret key or legacy service_role key; never put it in public/.
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
